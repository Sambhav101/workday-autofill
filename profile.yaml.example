# Canonical profile — single source of truth for autofill.
#
# This is a FAKE sample. Copy it to profile.yaml (gitignored) and replace every
# value with your own, OR run `python -m src.setup` to generate profile.yaml
# interactively. Sensitive EEO fields are intentionally blank — never auto-guessed.

identity:
  first_name: John
  last_name: Sample
  preferred_name: John
  email: john.sample@example.com
  phone: "+1 555-0100"

contact:
  address_line1: 123 Example Street
  city: Springfield
  state: IL
  postal_code: "62704"
  country: United States

links:
  linkedin: https://linkedin.com/in/john-sample
  website: https://johnsample.example.com
  github: https://github.com/johnsample

# Path to the resume PDF the tool uploads to Workday's resume field.
resume_path: ""        # e.g. /Users/you/Documents/resume.pdf

work_experience:
  - company: Acme Corporation
    title: Senior Software Engineer
    location: Springfield, IL, USA
    start: 2022-01
    end: 2025-05
    current: false
    bullets:
      - Led development of a customer-facing web platform serving millions of requests per day.
      - Designed and operated cloud microservices with automated CI/CD and on-call monitoring.
      - Mentored engineers and drove adoption of testing and code-review practices.
  - company: Globex Inc.
    title: Software Engineer
    location: Metropolis, NY, USA
    start: 2019-06
    end: 2021-12
    current: false
    bullets:
      - Built RESTful backend services and ETL pipelines feeding an analytics warehouse.
      - Shipped features across the stack in Python, TypeScript, and SQL.

education:
  - school: Example State University
    degree: Master's
    field: Computer Science
    gpa: "3.7"
    start: 2017-08
    end: 2019-05
    current: false
    # Workday's school search/list names often differ from the real name.
    # search_term: what to type into Workday's school search box.
    # workday_name: the exact option to pick from the results.
    # Leave both out to let the tool derive a search term from `school`.
    search_term: Example State
    workday_name: Example State University
  - school: Example Community College
    degree: Bachelor's
    field: Computer Science
    gpa: "3.8"
    start: 2013-08
    end: 2017-05
    current: false

skills:
  languages: [Python, Java, TypeScript, SQL, Go]
  ml_ai: [TensorFlow, scikit-learn, Pandas]
  cloud_tools: [AWS, Docker, PostgreSQL, Linux/Unix]

# ── SENSITIVE — you must set these. Never auto-guessed. ──────────────────────
sensitive:
  work_authorization: ""        # TODO e.g. "Authorized to work in the US"
  requires_sponsorship: ""      # TODO "Yes" / "No" — visa sponsorship now or future
  gender: ""                    # optional, EEO — leave blank to decline
  race_ethnicity: ""            # optional, EEO
  veteran_status: ""            # optional, EEO
  disability_status: ""         # optional, EEO
  hispanic_latino: ""           # optional, EEO

# ── Common free-text fallbacks (LLM may refine per job) ─────────────────────
preferences:
  how_did_you_hear: "Company website"
  desired_salary: ""            # TODO optional
  willing_to_relocate: ""       # TODO Yes/No
  earliest_start_date: ""       # TODO

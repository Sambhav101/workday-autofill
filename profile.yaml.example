# Canonical profile — single source of truth for autofill.
# Seeded from resume.tex. PLEASE REVIEW: corrections welcome, especially TODOs.
# Sensitive fields are intentionally blank for you to set — never LLM-guessed.

identity:
  first_name: Jane
  last_name: Doe
  preferred_name: Jane
  # NOTE: resume lists you@example.com, but your account email is
  # you@example.com — confirm which to use on applications.
  email: you@example.com
  phone: ""            # TODO: not on resume — add your phone number

